# Copy to .env and fill in your values — never commit .env

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ── DynamoDB ──────────────────────────────────────────────────────────────────
DYNAMODB_USERS_TABLE=focusguard_users
DYNAMODB_TASKS_TABLE=focusguard_tasks

# ── Bedrock ───────────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_32+_random_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+16625255170
DEFAULT_ALERT_PHONE=+918433654259

# ── n8n ───────────────────────────────────────────────────────────────────────
# Local dev:   http://localhost:5678/webhook/focusguard-alert
# n8n cloud:   https://YOUR-WORKSPACE.app.n8n.cloud/webhook/focusguard-alert
N8N_WEBHOOK_URL=http://localhost:5678/webhook/focusguard-alert
N8N_WEBHOOK_SECRET=aegisai-n8n-secret

# ── Public URL ────────────────────────────────────────────────────────────────
# Used by Twilio to send call responses back to this backend
# Local dev:   run `ngrok http 8000` and paste the https URL
# Production:  https://focusguard-backend.up.railway.app
API_PUBLIC_URL=http://localhost:8000

# ── n8n environment variable (set this inside n8n cloud settings) ─────────────
# In n8n cloud: Settings → Variables → Add Variable
# Name:  FOCUSGUARD_BACKEND_URL
# Value: https://focusguard-backend.up.railway.app  (or your ngrok URL)
